%% Dash Electric Logistic — canonical ERD
%% Source of truth: nest-logistic-service/src/database/schema/table/*.ts (Drizzle).
%% Field names match the actual Postgres columns. External masters (clients,
%% users, riders, hubs, providers, outlets) live in nodejs-core-service and are
%% referenced by id without a DB FK — they appear as snapshot JSONB columns,
%% not as entities below. Every PRD/TRD that adds or changes data must update
%% this file in the same change.

erDiagram
    %% ── Intake & inbound (Stage 2: CSV upload → shipments → items → hub scan) ──
    UPLOAD_SHIPMENTS ||--o{ SHIPMENTS : "imports (soft fk)"
    SHIPMENTS ||--o{ ITEMS : contains
    ITEMS ||--o{ ITEM_STATUS_HISTORY : "audits transitions"
    ITEMS ||--o{ SCAN_EVENTS : "scanned via"

    %% ── Dispatch (plan → batches → stops → item assignment) ──
    DISPATCHES ||--o{ BATCHES : plans
    BATCHES ||--o{ BATCH_STOPS : visits
    BATCHES ||--o{ BATCH_ITEMS : carries
    BATCH_STOPS ||--o{ BATCH_ITEMS : "drops at"
    ITEMS ||--o{ BATCH_ITEMS : "assigned to batch"

    %% ── Shipment routes (see docs/modules/shipment-route — prd-trd v1 DRAFT) ──
    %% One route = one rider journey; ordered stops typed PICKUP|DROP_OFF; a stop
    %% serves 1+ shipments. Additive to dispatch/batches, which stay unchanged.
    %% The rider executes the route natively (logistic-service /v1/routes, rider JWT):
    %% start → DIRECT_4W checklist + 8-item vehicle check → stops → end + end check.
    %% ROUTES has NO status column: status is derived from started_at/completed_at
    %% (null→PLANNED, started→IN_PROGRESS, completed→COMPLETED). There is no
    %% CANCELLED state — routes cannot be cancelled (decided 2026-08-06).
    ROUTES ||--o{ ROUTE_STOPS : "visits in sequence"
    ROUTES ||--o{ ROUTE_STOP_SHIPMENTS : serves
    ROUTE_STOPS ||--o{ ROUTE_STOP_SHIPMENTS : "serves at stop"
    SHIPMENTS ||--o{ ROUTE_STOP_SHIPMENTS : "routed via"

    %% ── Stop workflows (see docs/modules/stop-workflow — prd-trd v1 DRAFT) ──
    %% Per-client door-side forms. Definitions normalized below (cold, admin-side);
    %% execution denormalized: the resolved definition + submission state is
    %% snapshotted into route_stops.workflow (single nullable JSONB) at route
    %% creation — null means the m-app's static workflow applies.
    STOP_WORKFLOWS ||--o{ WORKFLOW_MILESTONES : "ordered steps"
    WORKFLOW_MILESTONES ||--o{ WORKFLOW_FIELDS : "ordered inputs"
    ROUTE_STOPS ||--o{ WORKFLOW_SUBMISSIONS : "milestone evidence"
    STOP_WORKFLOWS ||--o{ WORKFLOW_SUBMISSIONS : "submitted against"

    %% ── Invoice (proof-of-delivery + AI checker) ──
    INVOICES ||--o{ INVOICE_STATUS_HISTORY : "audits transitions"
    INVOICES ||--o{ AI_CHECKER_LOGS : "checked by"

    %% ── Zoning (hub coverage by H3 cells; disjoint cell invariant) ──
    ZONES ||--o{ ZONE_CELLS : "covers H3 cells"

    UPLOAD_SHIPMENTS {
        uuid id PK
        text code "unique"
        integer client_id "external core-service.clients.id"
        text uploaded_by "JWT email"
        text file_name
        integer total_rows
        integer total_shipments
        integer total_items
        text status "PROCESSING|COMPLETED|FAILED"
        jsonb error_log
        timestamptz uploaded_at
        timestamptz completed_at
        timestamptz created_at
        timestamptz updated_at
    }

    SHIPMENTS {
        uuid id PK
        text waybill "unique"
        uuid upload_shipment_id FK "soft → upload_shipments.id"
        integer client_id "external core-service.clients.id"
        jsonb client "ShipmentClientSnapshot {id,name}"
        text booking_id
        integer event_seq "webhook ordering counter per shipment (webhook_outbox.sequence)"
        text delivery_group_id
        text service_type
        text type "DOCKING|DIRECT_2W|DIRECT_4W default DOCKING — set at intake; a route derives its type from the shipments it serves"
        text priority_time_window "HH:MM - HH:MM"
        text sender_name
        text sender_phone
        text receiver_name
        text receiver_phone
        text origin_address
        numeric origin_lat
        numeric origin_long
        text origin_h3_index
        text origin_phone
        text destination_address
        numeric destination_lat
        numeric destination_long
        text destination_h3_index
        text destination_phone
        numeric total_weight
        numeric total_volume
        text status "default CREATED"
        timestamptz dispatched_at
        uuid dispatched_by
        timestamptz cancelled_at
        uuid cancelled_by
        text cancellation_reason
        integer external_provider_id
        integer external_shift_id
        text revenue_stream "snapshot core-service.providers.revenue_stream"
        integer hub_id "external core-service pitstop id"
        jsonb hub "HubSnapshot {id,name,address,lat,long}"
        timestamptz created_at
        timestamptz updated_at
    }

    ITEMS {
        uuid id PK
        uuid shipment_id FK "→ shipments.id CASCADE"
        text hub_id "external core-service pitstop id"
        jsonb hub "HubSnapshot cloned from shipment"
        text item_name
        text invoice "PO/SP number"
        text description
        integer quantity ">0"
        numeric weight
        numeric volume
        numeric price
        text origin_address
        numeric origin_lat
        numeric origin_long
        text origin_h3_index
        text destination_address
        numeric destination_lat
        numeric destination_long
        text destination_h3_index
        timestamptz scanned_at "hub-inbound scan"
        uuid scanned_by
        timestamptz handed_over_at "rider pickup at hub"
        text assigned_rider_code
        bigint assigned_rider_id
        timestamptz assigned_at
        text assigned_by
        text external_delivery_uid
        timestamptz bridged_at
        text exception_note
        text status "default CREATED"
        timestamptz cancelled_at
        uuid cancelled_by
        text cancellation_reason
        timestamptz created_at
        timestamptz updated_at
    }

    ITEM_STATUS_HISTORY {
        uuid id PK
        uuid item_id FK "→ items.id CASCADE"
        text from_status
        text to_status
        text changed_by "email or identifier"
        text note
        timestamptz changed_at
    }

    SCAN_EVENTS {
        uuid id PK
        text scan_uid "unique — client-generated idempotency key"
        uuid item_id FK "→ items.id"
        timestamptz scanned_at
        uuid scanned_by
    }

    DISPATCHES {
        uuid id PK
        text code "unique"
        bigint hub_id "external core-service pitstop id"
        jsonb riders_snapshot
        numeric max_weight_kg
        numeric max_volume_m3
        numeric max_stop_radius_km
        integer shift_minutes "default 480 (8h)"
        jsonb time_model_snapshot "{hubOverheadMin,baseServiceMinPerStop,avgSpeedKmh,circuityFactor}"
        jsonb client_buffers_snapshot
        integer total_items
        integer total_batches
        integer deferred_batch_count
        integer deferred_item_count
        integer unbatchable_count
        text status "default PREVIEW"
        jsonb planner_stats
        text triggered_by
        timestamptz committed_at
        timestamptz created_at
        timestamptz updated_at
    }

    BATCHES {
        uuid id PK
        text code "unique — BTH{yymmdd}{seq5}"
        uuid dispatch_id FK "→ dispatches.id CASCADE"
        bigint hub_id
        jsonb hub "HubSnapshot"
        text assigned_rider_code
        bigint assigned_rider_id
        text assigned_rider_name
        integer trip_sequence
        integer stop_count
        integer item_count
        numeric total_weight_kg
        numeric total_volume_m3
        integer estimated_time_minutes
        text status "default PLANNED"
        text route_polyline "Mapbox snapshot"
        integer route_distance_m
        integer route_duration_sec
        timestamptz route_computed_at
        timestamptz bridged_at
        timestamptz created_at
        timestamptz updated_at
    }

    BATCH_STOPS {
        uuid id PK
        uuid batch_id FK "→ batches.id CASCADE"
        integer sequence "unique within batch"
        text destination_key
        text destination_address
        numeric destination_lat
        numeric destination_long
        text zone_code
        text zone_name
        integer item_count
        numeric total_weight_kg
        numeric total_volume_m3
        integer distinct_client_count
        integer computed_stop_time_min
        integer leg_distance_m "Mapbox leg ending here"
        integer leg_duration_sec
        timestamptz created_at
    }

    BATCH_ITEMS {
        uuid id PK
        uuid batch_id FK "→ batches.id CASCADE"
        uuid batch_stop_id FK "→ batch_stops.id CASCADE"
        uuid item_id FK "→ items.id (unique per batch)"
        numeric weight_kg
        numeric volume_m3
        boolean deferred "default false"
        timestamptz created_at
    }

    ROUTES {
        uuid id PK
        text code "unique — RTE{yymmdd}{seq5}"
        text idempotency_key "unique, nullable — replay-safe creation"
        uuid route_plan_id FK "→ route_plans.id, nullable — trace to the template the stops came from (CR-2, 0095); null on every manual/import path"
        date planned_date "the day the rider works this route — rider list filters on it"
        text rider_id "external core-service rider id"
        jsonb rider "RiderSnapshot {id,code,name,phone_number}"
        integer stop_count
        integer shipment_count
        numeric total_weight_kg
        numeric total_volume_m3
        jsonb pre_checklist_agreement "nullable — DIRECT_4W only: {agreed,checklistVersion,agreedAt} set at route start"
        jsonb start_check "nullable — DIRECT_4W only: {selfie,vehicleFront,vehicleBack,vehicleLeft,vehicleRight,vehicleBox,odometerPhoto,odometerReading,submittedAt}"
        jsonb end_check "nullable — DIRECT_4W only, same shape, SEPARATE column (never merged with start_check); odometerReading >= start_check's"
        text route_polyline "provider snapshot — ONE geometry for the whole journey (matches batches.route_polyline); stops carry distance/duration per leg, never their own polyline"
        integer route_distance_m
        integer route_duration_sec
        timestamptz route_computed_at
        timestamptz started_at "null = PLANNED; set by the rider's explicit start"
        timestamptz completed_at "set when the derivation passes; these two ARE the status"
        timestamptz created_at
        timestamptz updated_at
    }

    ROUTE_STOPS {
        uuid id PK
        uuid route_id FK "→ routes.id CASCADE"
        integer sequence "unique within route"
        text type "PICKUP|DROP_OFF"
        text address
        numeric latitude
        numeric longitude
        text h3_index
        text contact_name
        text contact_phone
        integer shipment_count
        numeric total_weight_kg
        numeric total_volume_m3
        integer leg_distance_m "provider leg ending here"
        integer leg_duration_sec
        text status "PENDING|COMPLETED|FAILED|SKIPPED default PENDING"
        jsonb workflow "nullable — WorkflowSnapshot (definition + submission state); null = m-app static workflow; CR-5: + fallback, pinnedWorkflowId, fallbackReason when a plan pin fell back to the slot default"
        timestamptz arrived_at "nullable — rider arrival at the stop"
        timestamptz resolved_at
        text resolved_by
        text resolution_reason
        timestamptz created_at
        timestamptz updated_at
    }

    ROUTE_STOP_SHIPMENTS {
        uuid id PK
        uuid route_id FK "→ routes.id (denormalized for active-route invariant)"
        uuid route_stop_id FK "→ route_stops.id CASCADE"
        uuid shipment_id FK "→ shipments.id (unique per stop; ≤1 stop per type per route)"
        numeric weight_kg
        numeric volume_m3
        text status "ACTIVE|BLOCKED|CANCELLED default ACTIVE"
        timestamptz created_at
        timestamptz updated_at
    }

    STOP_WORKFLOWS {
        uuid id PK
        integer client_id "external core-service client id (no FK)"
        jsonb client "frozen {id,name} snapshot from core-service; nullable (best-effort)"
        text name
        text stop_type "PICKUP|DROP_OFF — the stop type this workflow gates, never both"
        text status "ACTIVE|INACTIVE default ACTIVE — one ACTIVE per (client_id, stop_type) (partial unique)"
        timestamptz created_at
        timestamptz updated_at
    }

    WORKFLOW_MILESTONES {
        uuid id PK
        uuid workflow_id FK "→ stop_workflows.id CASCADE"
        integer sequence "unique within workflow"
        text key "unique within workflow"
        text name
        timestamptz created_at
        timestamptz updated_at
    }

    WORKFLOW_FIELDS {
        uuid id PK
        uuid milestone_id FK "→ workflow_milestones.id CASCADE"
        integer sequence "unique within milestone"
        text key "unique within milestone"
        text label
        text type "IMAGE|TEXT|NUMBER"
        boolean required "default true"
        jsonb config "nullable — {imageCount} xor {multiple} for IMAGE; {maxLength|min|max} for TEXT/NUMBER"
        timestamptz created_at
        timestamptz updated_at
    }

    WORKFLOW_SUBMISSIONS {
        uuid id PK
        uuid route_stop_id FK "→ route_stops.id"
        uuid workflow_id "soft → stop_workflows.id (definition also frozen in stop snapshot)"
        text milestone_key "unique with route_stop_id — append-only, one submission per milestone"
        integer milestone_sequence
        jsonb values "submitted field values {fieldKey: value}"
        text submitted_by
        timestamptz submitted_at
    }

    INVOICES {
        uuid id PK
        text invoice_number "unique — PT-INV-…"
        text airwaybill
        text batch_id
        jsonb rider "InvoiceRiderSnapshot {id,name}"
        jsonb client "InvoiceClientSnapshot {id,name}"
        jsonb outlet "InvoiceOutletSnapshot {id?,name,address?}"
        jsonb hub "InvoiceHubSnapshot {id?,name,address?}"
        integer items_count ">=0"
        date issue_date
        date due_date
        text status
        jsonb invoice_images "InvoiceImageSet {spType,images[]}"
        timestamptz returned_at
        timestamptz collected_at
        timestamptz submitted_to_client_at
        timestamptz client_acknowledged_at
        text exception_code
        text notes
        timestamptz created_at
        timestamptz updated_at
    }

    INVOICE_STATUS_HISTORY {
        uuid id PK
        uuid invoice_id FK "→ invoices.id"
        text from_status
        text to_status
        timestamptz changed_at
        jsonb changed_by "{id,name,role}"
        text note
        jsonb invoice_images "snapshot at transition"
    }

    AI_CHECKER_LOGS {
        uuid id PK
        uuid invoice_id FK "→ invoices.id"
        text sp_type "AI-detected"
        text order_id "AI-extracted PO/invoice no."
        boolean passed
        boolean is_strict_mode "ENABLE_STRICT_AI_CHECKER flag at check time"
        jsonb items "AiCheckerLogItemSnapshot[]"
        jsonb errors "string[]"
        jsonb raw_results "{currentPoNumber,results[]}"
        jsonb invoice_images
        jsonb token_usage "{promptTokenCount,candidatesTokenCount,totalTokenCount}"
        jsonb checked_by "{id,name,role}"
        timestamptz checked_at
    }

    ZONES {
        uuid id PK
        bigint hub_id "external core-service pitstop id"
        varchar code "unique per hub"
        varchar name
        varchar color "#RRGGBB"
        varchar status "default active"
        timestamptz created_at
        timestamptz updated_at
    }

    ZONE_CELLS {
        uuid id PK
        uuid zone_id FK "→ zones.id"
        varchar h3_index "globally unique (disjoint-cells invariant)"
    }

    %% --- docking-dashboard module (lives inside nest-logistic-service; see docs/modules/docking-dashboard) ---
    %% One row per (hub, day), populated by a daily 00:00 WIB ETL job. JSONB arrays hold
    %% items/batches/dispatches that touched that hub on that day — row-level grain preserved
    %% so today's metrics, tomorrow's new metrics, and AI summarization all read the same data.
    %% No FK to items/batches/dispatches — the source row data lives inside the JSONB columns.
    %% `batches` nests `stops` (from batch_stops), and each stop nests its `items` (item_id ref +
    %% denormalized handed_over_at) so zone metrics traverse the JSONB without joins.
    DASHBOARD_HUB_DAILY_SNAPSHOTS {
        uuid id PK
        date snapshot_date "yesterday in WIB at ETL time"
        bigint hub_id "external core-service pitstop id"
        jsonb hub "hub master snapshot at capture"
        jsonb items "flat array of items that touched this hub on this day"
        jsonb batches "array of batches; each batch nests its stops, each stop nests its items"
        jsonb dispatches "array of dispatches"
        jsonb external_data "cross-service captures (delivery-service later)"
        jsonb row_counts "{items,batches,stops,dispatches} for canary alerts"
        text etl_status "OK | EMPTY | PARTIAL | FAILED"
        timestamptz etl_started_at
        timestamptz etl_completed_at
        timestamptz source_cutoff_at "the instant this snapshot represents"
        timestamptz created_at
        timestamptz updated_at
    }

    %% --- analytics-dashboard module (read-only meta-layer; see docs/modules/analytics-dashboard) ---
    %% KPI_VALUE stores captured values by reference; it does not FK into the operational
    %% entities above. value is nullable by design (NULL means "no data", never 0).
    SNAPSHOT ||--o{ KPI_VALUE : contains
    KPI_DEFINITION ||--o{ KPI_VALUE : "measured as"
    DEPLOYMENT ||--o{ VERDICT : "judged by"
    DEPLOYMENT ||--o{ ACTION_ITEM : tracks
    SNAPSHOT ||--o{ VERDICT : "baseline for"
    SNAPSHOT ||--o{ VERDICT : "after for"

    KPI_DEFINITION {
        string id PK
        string name
        string unit
        string direction
        decimal significance_bar
        string source_service
        bool sensitive
    }
    SNAPSHOT {
        string id PK
        datetime taken_at
        string trigger
        string status
    }
    KPI_VALUE {
        string id PK
        string snapshot_id FK
        string kpi_id FK
        decimal value
        string capture_status
    }
    DEPLOYMENT {
        string id PK
        string module
        datetime shipped_at
        string source
        string notes
    }
    ACTION_ITEM {
        string id PK
        string deployment_id FK
        string title
        string status
        datetime created_at
    }
    VERDICT {
        string id PK
        string deployment_id FK
        string state
        decimal confidence
        string baseline_snapshot_id FK
        string after_snapshot_id FK
        json evidence
        string overridden_by
        string override_note
        datetime created_at
    }

    %% ── Warehouse management (see docs/modules/warehouse-management — prd-trd v1 DRAFT) ──
    %% MVP WMS: hubs are the warehouses (external core-service pitstops, no local master).
    %% Storage is a 3-level hierarchy per hub — LOCATION → SECTION → BIN — stored as a
    %% Postgres ltree `path` on wh_storages (self-reference via path, no parent_id;
    %% nlevel(path) 1|2|3 = category). Stock lives ONLY at BIN level. Granularity:
    %% bin × client × SKU × lot, with qty_on_hand >= qty_reserved >= 0 enforced by check
    %% constraints. Every quantity change appends one WH_STOCK_MOVEMENTS row (polymorphic
    %% ref to the causing doc, no FK). Reserve at GI creation (FEFO by expiry, lot age
    %% tiebreak), deduct at ship. Documents are never deleted — status transitions only.
    %% No stock opname / count adjustment in MVP (decided 2026-08-12). All quantities numeric(12,2).
    %% v2 DRAFT (wms-prd-trd-v2): outbound orders (manual form, CSV upload, client API later), CSV upload log,
    %% purchase orders, surat jalan, picking qty. Integration with shipments is a synchronous interface call
    %% (ports & adapters) in the same transaction — WMS has NO FK into other modules; the link is the soft
    %% reference wh_outbound_orders.fulfillment_shipment_id.
    WH_STORAGES ||--o{ WH_STORAGES : "path (ltree, self-ref)"
    WH_STORAGES ||--o{ WH_STOCKS : "holds (BIN only)"
    WH_STORAGES ||--o{ WH_GOODS_RECEIPT_LINES : "receives into"
    WH_STORAGES ||--o{ WH_GOODS_ISSUE_LINES : "picked from"
    WH_GOODS_RECEIPTS ||--o{ WH_GOODS_RECEIPT_LINES : contains
    WH_GOODS_ISSUES ||--o{ WH_GOODS_ISSUE_LINES : contains
    WH_STOCKS ||--o{ WH_GOODS_ISSUE_LINES : "reserved against"
    WH_TRANSFERS ||--o{ WH_TRANSFER_LINES : contains
    WH_OUTBOUND_ORDERS ||--o{ WH_OUTBOUND_ORDER_LINES : contains
    WH_OUTBOUND_ORDERS ||--o{ WH_OUTBOUND_ORDER_EVENTS : "timeline"
    WH_OUTBOUND_ORDERS ||--o| WH_GOODS_ISSUES : "fulfilled by (active GI)"
    WH_PURCHASE_ORDERS ||--o{ WH_PURCHASE_ORDER_LINES : contains
    WH_PURCHASE_ORDERS ||--o{ WH_GOODS_RECEIPTS : "received by"
    WH_PURCHASE_ORDER_LINES ||--o{ WH_GOODS_RECEIPT_LINES : "received as"
    WH_OUTBOUND_ORDER_UPLOADS ||--o{ WH_OUTBOUND_ORDERS : "created by CSV commit"
    SHIPMENTS ||--o| WH_OUTBOUND_ORDERS : "fulfillment_shipment_id (soft ref, no FK)"

    WH_STORAGES {
        uuid id PK
        bigint hub_id "external core-service pitstop id"
        jsonb hub "HubSnapshot {id,name}"
        text code "unique per hub"
        text name
        text category "LOCATION|SECTION|BIN — derived from nlevel(path); stock/documents attach to BIN only"
        text type "on LOCATION: STORAGE|QUARANTINE|STAGING (inherited by children — only STORAGE lineage is FEFO-allocatable); null on SECTION/BIN"
        ltree path "hierarchy — parent = subpath(path, 0, nlevel(path)-1)"
        text status "ACTIVE|INACTIVE default ACTIVE — inactive rejects new stock, keeps existing"
        numeric width_cm "PROPOSED (wms-storage-occupancy prd-trd v1 DRAFT) — nullable, bin dimensions"
        numeric depth_cm "PROPOSED — nullable"
        numeric height_cm "PROPOSED — nullable"
        numeric capacity_cbm "PROPOSED — nullable; null = belum diset (not zero); derived from dims, editable"
        numeric capacity_kg "PROPOSED — nullable, optional"
        numeric capacity_qty "PROPOSED — nullable, optional (single-SKU bins)"
        timestamptz created_at
        timestamptz updated_at
    }

    %% PROPOSED (wms-storage-occupancy prd-trd v1 DRAFT, deferred 2026-10-12): warehouse map layout.
    %% One row per PLACED storage; pure presentation data, no FK into stock. Occupancy itself is a
    %% view over WH_STOCKS x WH_SKUS (used_cbm = sum qty * cbm_per_unit), never stored.
    WH_STORAGES ||--o| WH_STORAGE_LAYOUTS : "placed on map (PROPOSED)"
    WH_STORAGE_LAYOUTS {
        uuid id PK
        uuid storage_id FK "→ wh_storages.id — unique"
        bigint hub_id
        integer x "cm — LOCATION: from hub origin; SECTION: from its location origin"
        integer y "cm"
        integer w "LOCATION only — nullable"
        integer h "LOCATION only — nullable"
        jsonb blocks "LOCATION / hub floor — [{x,y,w,h}] relative to row origin; null = single w×h rectangle; 2–4 blocks = L/U/W shape"
        smallint rotation "0|90 default 0"
        text shape "SECTION only — RACK|FLOOR; bins are laid out from bin order (rack: col = i div levels, level = i mod levels)"
        smallint levels "RACK — nullable"
        smallint rows "FLOOR — nullable"
        smallint cell_cm "FLOOR — nullable"
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_STOCKS {
        uuid id PK
        uuid storage_id FK "→ wh_storages.id"
        bigint hub_id "denormalized for hub-level queries"
        integer client_id "external core-service.clients.id"
        jsonb client "ClientSnapshot {id,name}"
        text sku "client-declared string — no product master in MVP"
        text item_name "denormalized from GR line"
        text uom_name
        text lot_number "LOT{yymmdd}{seq} — stamped at GR post; never BTH (taken by batches)"
        date expired_date "nullable — FEFO sort key"
        numeric qty_on_hand "check >= 0 and >= qty_reserved"
        numeric qty_reserved "check >= 0"
        timestamptz created_at
        timestamptz updated_at
    }

    WH_GOODS_RECEIPTS {
        uuid id PK
        text code "unique — GR{yymmdd}{seq5}"
        bigint hub_id
        jsonb hub "HubSnapshot"
        integer client_id
        jsonb client "ClientSnapshot"
        text supplier_name "free text — no vendor master in MVP"
        uuid purchase_order_id FK "v2 — nullable → wh_purchase_orders.id (null = receipt without PO: return/compensating)"
        timestamptz arrived_at "v2"
        text delivery_note_no "v2 — supplier surat jalan number"
        text delivery_note_photo_url "v2"
        boolean closes_backorder "v2 default false — closes remaining PO qty"
        text notes
        text status "DRAFT|POSTED — post commits stock, irreversible (no adjustment feature in MVP; correction = compensating GR or GI/transfer out)"
        timestamptz posted_at
        text posted_by
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_GOODS_RECEIPT_LINES {
        uuid id PK
        uuid goods_receipt_id FK "→ wh_goods_receipts.id CASCADE"
        uuid storage_id FK "→ wh_storages.id — destination bin, must be ACTIVE at post"
        uuid purchase_order_line_id FK "v2 — nullable → wh_purchase_order_lines.id"
        text sku
        text item_name
        text uom_name
        numeric qty "check > 0"
        date expired_date "nullable"
        text lot_number "null while DRAFT; stamped at post"
        timestamptz created_at
        timestamptz updated_at
    }

    WH_GOODS_ISSUES {
        uuid id PK
        text code "unique — GI{yymmdd}{seq5}"
        bigint hub_id
        jsonb hub "HubSnapshot"
        integer client_id
        jsonb client "ClientSnapshot"
        text reference "free text — external order/waybill link (soft); v2 = outbound order code"
        uuid outbound_order_id FK "v2 — nullable → wh_outbound_orders.id"
        text status "RESERVED|PICKED|READY_TO_PICKUP(v2)|SHIPPED|CANCELLED — reserve at create, deduct at ship; shipped cannot cancel"
        text surat_jalan_no "v2 — unique, SJ/{hubCode}/{yymm}/{seq4}, stamped at ready-to-pickup"
        timestamptz ready_at "v2"
        text ready_by "v2"
        text picker_name
        timestamptz picked_at
        timestamptz shipped_at
        text shipped_by
        timestamptz cancelled_at
        text cancelled_by
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_GOODS_ISSUE_LINES {
        uuid id PK
        uuid goods_issue_id FK "→ wh_goods_issues.id CASCADE"
        uuid stock_id FK "→ wh_stocks.id — the reserved lot row"
        uuid storage_id FK "→ wh_storages.id — source bin (denormalized)"
        text sku
        text item_name
        text uom_name
        text lot_number
        numeric qty_reserved "check > 0"
        numeric qty_picked "v2 default 0 — check 0 <= qty_picked <= qty_reserved"
        timestamptz created_at
    }

    %% wms-transfer-opname prd-trd v1 (2026-10-12): the instant transfer became an approval document.
    %% Reserve at create (qty_reserved += qty), move + TRANSFER ledger rows at DONE, release at REJECTED.
    WH_TRANSFERS ||--o{ WH_TRANSFER_EVENTS : "timeline"
    WH_TRANSFERS {
        uuid id PK
        text code "unique — TRF-INT-{MMDDYY}-{RAND4}"
        bigint hub_id
        jsonb hub "HubSnapshot"
        uuid source_storage_id FK "→ wh_storages.id"
        uuid dest_storage_id FK "→ wh_storages.id — same hub as source"
        text status "REQUESTED|APPROVED|PREPARING|DONE|REJECTED — default DONE serves rows from before the column (instant transfers)"
        text notes
        timestamptz approved_at
        text approved_by
        timestamptz preparing_at
        text preparing_by
        timestamptz done_at
        text done_by
        timestamptz rejected_at
        text rejected_by
        text reject_reason
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_TRANSFER_LINES {
        uuid id PK
        uuid transfer_id FK "→ wh_transfers.id CASCADE"
        integer line_no
        uuid stock_id FK "→ wh_stocks.id — source lot reserved at create (null on legacy rows)"
        text sku
        text item_name
        text uom_name
        text batch_number
        date expired_date "snapshot"
        numeric qty "check > 0 — source available must cover it at create"
        timestamptz created_at
    }

    WH_TRANSFER_EVENTS {
        uuid id PK
        uuid transfer_id FK "→ wh_transfers.id CASCADE"
        text status "status after the event; null = informational"
        text title
        text note
        text actor
        timestamptz occurred_at
    }

    %% Stock opname (wms-transfer-opname prd-trd v1): count per storage × sku × batch, two approvals.
    %% gap == 0 for every line → DONE/WITHOUT_ADJUSTMENT at create. Manager approve reserves |gap| on deficit
    %% lines; FAT approve posts on_hand += gap (new batches insert a stock row) and writes ADJUSTMENT ledger rows.
    %% A (storage, sku) pair can sit in only one non-terminal opname per hub (OPNAME_LOCKED).
    WH_STOCK_OPNAMES ||--o{ WH_STOCK_OPNAME_LINES : contains
    WH_STOCK_OPNAMES ||--o{ WH_STOCK_OPNAME_EVENTS : "timeline"
    WH_STORAGES ||--o{ WH_STOCK_OPNAME_LINES : "counted in"
    WH_STOCKS ||--o{ WH_STOCK_OPNAME_LINES : "counted lot (null when new batch)"
    WH_STOCK_OPNAMES {
        uuid id PK
        text code "unique — OPN-{MMDDYY}-{RAND4}"
        bigint hub_id
        jsonb hub "HubSnapshot"
        integer client_id
        jsonb client "ClientSnapshot"
        text type "WITH_ADJUSTMENT|WITHOUT_ADJUSTMENT — decided at create from the gaps"
        text status "WAITING_MANAGER_APPROVAL|WAITING_FAT_APPROVAL|DONE|REJECTED_BY_MANAGER|REJECTED_BY_FAT"
        text notes
        text report_url "berita acara / countsheet — required, warehouse upload URL"
        integer line_count
        integer gap_line_count
        numeric total_qty_system
        numeric total_qty_physical
        numeric total_gap "signed"
        timestamptz approved_at
        text approved_by
        timestamptz fat_approved_at
        text fat_approved_by
        timestamptz rejected_at
        text rejected_by
        text reject_reason
        timestamptz done_at
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_STOCK_OPNAME_LINES {
        uuid id PK
        uuid stock_opname_id FK "→ wh_stock_opnames.id CASCADE"
        integer line_no
        uuid storage_id FK "→ wh_storages.id"
        uuid stock_id FK "→ wh_stocks.id — null while is_new_batch (set at FAT approve)"
        text sku
        text item_name
        text uom_name
        text batch_number "existing batch, or generated from the opname code + expiry when new"
        date expired_date
        boolean is_new_batch
        numeric qty_system "qty_on_hand at create (0 for a new batch)"
        numeric qty_physical "check >= 0"
        numeric qty_gap "qty_physical - qty_system, signed"
        text notes
        timestamptz created_at
    }

    WH_STOCK_OPNAME_EVENTS {
        uuid id PK
        uuid stock_opname_id FK "→ wh_stock_opnames.id CASCADE"
        text status
        text title
        text note
        text actor
        timestamptz occurred_at
    }

    WH_STOCK_MOVEMENTS {
        uuid id PK
        bigint hub_id
        integer client_id
        text sku
        text lot_number
        text type "INBOUND|OUTBOUND|TRANSFER|ADJUSTMENT (stock opname, signed delta)"
        text ref_type "GOODS_RECEIPT|GOODS_ISSUE|TRANSFER|STOCK_OPNAME — polymorphic, no FK"
        uuid ref_id "id of the causing document"
        text ref_code "denormalized document code"
        uuid storage_from_id "nullable — null for INBOUND"
        uuid storage_to_id "nullable — null for OUTBOUND"
        numeric qty_delta "signed; append-only — ledger sum per stock row == qty_on_hand"
        text created_by
        timestamptz created_at
    }

    WH_SKUS {
        uuid id PK
        integer client_id "external core-service.clients.id"
        jsonb client "ClientSnapshot {id,name}"
        text sku "unique per client — receipts/issues/orders pick from this catalog"
        text item_name
        text uom_name "fixed UoM list, validated in code"
        numeric length_cm "nullable"
        numeric width_cm "nullable"
        numeric height_cm "nullable"
        numeric weight_kg "v2 — nullable, per unit; drives shipment item weight"
        timestamptz created_at
        timestamptz updated_at
    }

    WH_OUTBOUND_ORDERS {
        uuid id PK
        text code "unique — OO{yymmdd}{random5}"
        text source "MANUAL|CSV|CLIENT_API"
        text external_id "idempotency key (defaults to code for manual orders) — unique (client_id, external_id, is_sandbox)"
        uuid upload_id FK "nullable → wh_outbound_order_uploads.id (source CSV)"
        bigint hub_id
        jsonb hub "HubSnapshot {id,name,code}"
        integer client_id
        jsonb client "ClientSnapshot"
        text status "OPEN|PREPARING|READY_TO_PICKUP|SHIPPED|IN_DELIVERY|DELIVERED|FAILED|CANCELLED — projection of GI + fulfillment"
        text service_type "SAME_DAY|NEXT_DAY, default SAME_DAY"
        text method "DELIVERY"
        text recipient_name
        text recipient_phone
        text destination_address
        numeric destination_lat
        numeric destination_long
        text destination_notes
        text destination_city "CR-1: snapshot of the resolved city name (text from the address, or the core m_city name)"
        integer destination_city_id "CR-1: nullable soft ref core-service m_city.id — null when unresolved/ambiguous"
        integer distance "metres, nullable — WMS mode (DISTANCE_WMS_CALCULATION_MODE), typed in Ubah, or filled by dispatch via ShipmentDistanceHook when null (CR-1)"
        text notes
        timestamptz order_date
        date expected_delivery_date
        boolean is_sandbox
        uuid api_key_id "nullable — phase 2 client API"
        integer event_seq "webhook ordering counter per order (OUTBOUND_ORDER topic) — wms-client-api-outbound-prd-trd-v1 § Fase 2"
        uuid goods_issue_id "nullable — active GI"
        text fulfillment_status "nullable — AT_HUB|DISPATCHED|IN_DELIVERY|DELIVERED|FAILED|RETURNED|CANCELLED"
        uuid fulfillment_shipment_id "nullable, indexed — soft ref shipments.id (set at ship, same tx)"
        text fulfillment_waybill "nullable"
        timestamptz cancelled_at
        text cancelled_by
        text cancellation_reason
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_OUTBOUND_ORDER_LINES {
        uuid id PK
        uuid outbound_order_id FK "→ wh_outbound_orders.id CASCADE"
        text sku "validated against wh_skus at create"
        text item_name
        text uom_name
        numeric qty "check > 0"
        text notes
        timestamptz created_at
    }

    WH_OUTBOUND_ORDER_EVENTS {
        uuid id PK
        uuid outbound_order_id FK "→ wh_outbound_orders.id"
        text status "nullable — status after the event"
        text title
        text note
        text actor
        text origin "WMS|FULFILLMENT|CLIENT"
        timestamptz occurred_at
    }

    WH_PURCHASE_ORDERS {
        uuid id PK
        text code "unique — PO{yymmdd}{random5}"
        bigint hub_id
        jsonb hub "HubSnapshot"
        integer client_id
        jsonb client "ClientSnapshot"
        text supplier_name "free text"
        timestamptz est_arrival_at
        text notes
        text status "DRAFT|CONFIRMED|CANCELLED"
        text receipt_status "nullable — SCHEDULED|PARTIAL_RECEIPT|FINISHED; inbound request = CONFIRMED PO"
        timestamptz confirmed_at
        text confirmed_by
        timestamptz cancelled_at
        text cancelled_by
        text cancellation_reason
        text created_by
        timestamptz created_at
        timestamptz updated_at
    }

    WH_PURCHASE_ORDER_LINES {
        uuid id PK
        uuid purchase_order_id FK "→ wh_purchase_orders.id CASCADE"
        text sku
        text item_name
        text uom_name
        numeric qty "check > 0"
        numeric qty_received "default 0 — check 0 <= qty_received <= qty"
        timestamptz created_at
        timestamptz updated_at
    }



    WH_DOCUMENT_SEQUENCES {
        text scope PK "e.g. SJ:3:2610 (doc:hub:yymm)"
        integer last_value
        timestamptz updated_at
    }

    WH_OUTBOUND_ORDER_UPLOADS {
        uuid id PK
        text code "unique — OOU{yymmdd}{random5}"
        bigint hub_id
        jsonb hub "HubSnapshot"
        integer client_id
        jsonb client "ClientSnapshot"
        text file_name
        integer total_rows
        integer created_count
        integer skipped_count "external_id already existed"
        text created_by
        timestamptz created_at "one row per successful CSV commit (all-or-nothing)"
    }

    %% ── UJP (ujp-prd-trd-v2) ─────────────────────────────────────
    ujp {
        uuid id PK
        text reference_id UK "UJP-YYYYMMDD-NNNN, daily counter"
        text status "SUBMITTED|APPROVED|REJECTED|CANCELLED"
        integer version "CR-3 (0096): 1 at create, +1 per requester edit; decision sends it back as expectedVersion → 409 UJP_STALE on a mismatch"
        int client_id "CoreService provider; jsonb snapshot"
        date delivery_date
        text payee_type "driver|subcon"
        numeric nominal_transfer
        text plate_number "vehicle snapshot + baseline, energy_price"
        uuid route_plan_id FK "→ route_plans.id, nullable — renamed from route_id (CR-2, 0095)"
        jsonb route "snapshot of the plan's stops + legs at submit — approve reads THIS, never route_plans"
        numeric km_all_legs
        numeric km_charged
        numeric km_yang_diajukan
        numeric total_uang_jalan_flazz
        numeric total_uang_jalan_transfer
        numeric estimated_amount
        uuid tariff_config_id FK "CR-4 (0097): → tariff_configs.id, nullable — tagged at create, resolved effective on delivery_date at approve"
        uuid ring_id FK "CR-4 (0097): → tariff_rings.id, nullable — PER_RING clients only; auto-suggested, approver-confirmed"
        numeric revenue_amount "CR-4 (0097): nullable — snapshot at approve; NULL unless revenue_status = OK (never fabricated)"
        numeric margin_amount "CR-4 (0097): nullable — revenue_amount − cost − komisi_amount (CR-4b), one approve-time basis; sign stored even when negative"
        numeric komisi_amount "CR-4b (0098): nullable — driver komisi applied to the margin (DRIVER payee only)"
        text revenue_status "CR-4 (0097): OK|MISSING_TARIFF|UNSUPPORTED_MODE|MISSING_RING — only OK yields a margin"
        jsonb tariff "CR-4 (0097): tariff + ring snapshot at approve (tipe, rates, asuransi, ring) — approver-only in the mapper"
        jsonb stops
        jsonb rider
        text requester_email
        text decided_by
        text reason_code FK
        uuid shipment_id FK "UNIQUE, set on approve"
        text search_text "STORED, GIN trgm"
    }
    ujp_status_history {
        uuid id PK
        uuid ujp_id FK
        text from_status
        text to_status
        text changed_by
        text reason_code
        jsonb changes "CR-3 (0096), nullable: [{field, from, to}] on EDITED and RESUBMITTED rows; money entries masked for non-parties on read"
        timestamptz changed_at
    }
    ujp_daily_counters {
        date day PK
        int next
    }
    ujp_vehicles {
        uuid id PK
        text plate_number UK
        text unit_type
        text energy_type "ICE|EV"
        numeric baseline
        numeric energy_price
        boolean active
    }
    ujp ||--o{ ujp_status_history : "audit"
    ujp ||--o| shipments : "shipments.ujp_id (approve creates)"
    ujp }o--|| reasons : "reason_code, type=UJP_REJECTION"
    ujp }o--o| ujp_vehicles : "snapshot at create"

    %% ── UJP CR-1 masters + route_plans (ujp-trd-v3 §14.2/§14.3) ──
    %% route_plans was ujp_routes until CR-2 (ujp-trd-v3 §14.3, migration
    %% 0095_route_plans): the route TEMPLATE now lives in the route module,
    %% next to the executed `routes` row it is the template for. Stops carry a
    %% snapshot plus a pointer at the addresses lane endpoint they came from;
    %% legs carry the km, where it came from, and whether ops overrode it.
    %% Deactivation only hides (active=false); rows are never deleted.
    route_plans {
        uuid id PK
        int client_id "CoreService provider — saved per client"
        text name "UNIQUE per client, case-insensitive"
        jsonb stops "ordered [{seq, role POSITIONING|PICKUP|DROP_OFF|RETURN, name, address, latitude, longitude, intent, address_id, endpoint origin|destination, workflow_id + workflow_name (CR-5 pin), type PICKUP|DROP_OFF + intent GENERIC|UNLOAD|RETURN_CONTAINER + pool (CR-6; role is derived)}]"
        jsonb legs "[{seq, fromSeq, toSeq, km, source LANE|DIRECTIONS|HAVERSINE, edited}]"
        numeric total_km "sum of all legs"
        numeric km_charged "legs touching no POSITIONING/RETURN stop"
        boolean active "false = hidden from pickers, never deleted"
        uuid default_ring_id FK "CR-4 (0097): → tariff_rings.id, nullable — pre-fills the wizard ring for PER_RING clients; the UJP still owns its own ring_id snapshot"
        text created_by
        text updated_by
    }
    ujp_client_configs {
        int client_id PK
        boolean charged_positioning "pool legs charged"
        numeric reverse_charge
        text default_e_money "NONE|FLAZZ|QRIS|FLAZZ_QRIS"
        text notes
        text updated_by
    }
    ujp_energy_prices {
        uuid id PK
        text fuel_type "SOLAR|DEXLITE|PERTALITE|EV_KWH"
        numeric price
        date effective_from "UNIQUE with fuel_type"
    }
    ujp_subcon_vendors {
        uuid id PK
        text name
        text city
        text bank_name
        text account_number
        text account_holder
        text pic_name
        text pic_phone
        boolean active
    }
    ujp }o--|| ujp_client_configs : "client rule at create"
    ujp }o--o| ujp_subcon_vendors : "subcon payee"
    ujp_vehicles }o--|| ujp_energy_prices : "fuel_type → price @ date"

    %% ── Route Planner, CR-2 (ujp-trd-v3 §14.3) ───────────────────
    %% route_plans.client_id is an external core-service master (snapshot rule above, no arrow).
    route_plans ||--o{ ROUTES : "routes.route_plan_id (executed from the template, nullable)"
    route_plans ||--o{ ujp : "ujp.route_plan_id + ujp.route snapshot"
    route_plans }o--o{ addresses : "stops point at lane endpoints (JSONB address_id, not a FK); manual stops write DRAFT lanes back"

    %% ── Tariff master, CR-4 (ujp-trd-v3 §14.5, migration 0097_tariff) ──
    %% The REVENUE side, client-scoped, dated — the counterpart to the COST-side
    %% ujp_client_configs (two configs, different concerns, no merge). Owned by a new
    %% `tariff` module; the UJP imports TariffRepository (arrow tariff ← ujp, like route ← ujp).
    %% Rings are config-scoped, NOT global: tariff_rings.tariff_config_id FK (mirrors source
    %% tarif_ring.tarif_id). The UJP tags tariff_config_id + ring_id at create and snapshots
    %% revenue_amount / margin_amount / revenue_status / tariff at approve; revenue is never
    %% fabricated (NULL unless revenue_status = OK). Deferred to CR-4b: per-body rates,
    %% distance_tiers, driver/helper shares, a standalone margin dashboard.
    tariff_configs {
        uuid id PK
        int client_id "CoreService provider — one active config per (client_id, date window)"
        text tipe "TARIFF_TIPE: PER_TRIP_FLAT|FIXED|PER_RING|DISTANCE_TIER (CR-4b, 0098)"
        numeric rate_flat "PER_TRIP_FLAT single-drop rate"
        numeric rate_flat_multi "PER_TRIP_FLAT multi-drop rate (0/unset → MULTI_RATE_FALLBACK to single)"
        numeric rate_fixed "FIXED rate"
        numeric asuransi "added to every resolved revenue, default 0"
        boolean mode_supported "legacy (CR-4): false → UNSUPPORTED_MODE; nothing sets it since CR-4b"
        jsonb rates_flat_per_body "CR-4b (0098): {unit_type: rate} single-drop overrides, 0/absent → base"
        jsonb rates_flat_per_body_multi "CR-4b: {unit_type: rate} multi-drop overrides"
        numeric driver_share_flat "CR-4b: komisi driver per trip (cost side of margin), default 0"
        numeric helper_share_flat "CR-4b: komisi helper per trip — recorded, not applied (no helper on a UJP)"
        numeric driver_share_flat_multi "CR-4b: multi-drop komisi, 0 → single"
        numeric helper_share_flat_multi "CR-4b: multi-drop komisi, 0 → single"
        numeric harga_reverse "CR-4b: added to revenue when ujp.is_reverse, default 0"
        jsonb hari_operasi "CR-4b: [MON..SUN] applicability, [] = every day"
        jsonb shift_operasi "CR-4b: [Dawn|Morning|Noon|Night] applicability, [] = every shift"
        boolean tagih_per_rit "CR-4b: stored + shown; the daily cap belongs to the report (CR-4c)"
        jsonb distance_tiers "CR-4b: [{maxKm, rate}] asc — DISTANCE_TIER prices km_yang_diajukan"
        int multidrop_free_points "CR-4b: drops included before the surcharge, default 3"
        numeric multidrop_extra_rate "CR-4b: per extra drop above free points, 0 = off"
        text catatan "CR-4b"
        date berlaku_mulai "effective from — resolution picks the config active on delivery_date"
        date berlaku_sampai "effective until, nullable = open-ended"
        boolean active
        text created_by
        text updated_by
    }
    tariff_rings {
        uuid id PK
        uuid tariff_config_id FK "→ tariff_configs.id — rings are config-scoped, not a global master"
        text nama "ring name, matched by suggestRing against the destination stop"
        int urutan "ordering + tie-break for the auto-suggest"
        numeric rate_per_trip "PER_RING single-drop rate"
        numeric rate_per_trip_multi "PER_RING multi-drop rate (0/unset → MULTI_RATE_FALLBACK to single)"
        jsonb rates_per_body "CR-4b (0098): {unit_type: rate} single-drop overrides"
        jsonb rates_per_body_multi "CR-4b: {unit_type: rate} multi-drop overrides"
        numeric driver_share "CR-4b: komisi driver per trip"
        numeric helper_share "CR-4b: komisi helper per trip (recorded only)"
        numeric driver_share_multi "CR-4b: multi-drop komisi, 0 → single"
        numeric helper_share_multi "CR-4b: multi-drop komisi, 0 → single"
        text keterangan "CR-4b"
        boolean active "0099: soft deactivate — hidden from the picker/auto-suggest; a tagged UJP keeps pricing"
    }
    tariff_configs ||--o{ tariff_rings : "config-scoped rings (tariff_config_id)"
    tariff_configs ||--o{ ujp : "tariff_config_id tagged at create, snapshotted at approve"
    route_plans ||--o| tariff_rings : "default_ring_id (nullable) pre-fills the wizard ring"

    %% ── Partner webhooks (nest-logistic-service docs/api-integration/webhook*.md; topic split + webhook list:
    %%    docs/modules/warehouse-management/wms-client-api-outbound-prd-trd-v1 § Fase 2.md) ──
    %% Transactional outbox: one WEBHOOK_OUTBOX row per (event × active endpoint), inserted in the producer's
    %% transaction (shipment status change, 4W milestone, or — new — outbound order status change through the
    %% warehouse OutboundOrderWebhookPort). Delivery = Cloud Tasks fast path + 1/min retry tick, HMAC-signed,
    %% backoff 1m→5m→15m→1h→3h→6h→12h then DEAD. client_id = core-service providers (external master, no FK).
    WEBHOOK_ENDPOINTS {
        uuid id PK
        integer client_id "external core-service provider id"
        text url "https only"
        text environment "LIVE|TEST — same wall as api_keys"
        text topic "SHIPMENT|OUTBOUND_ORDER, default SHIPMENT — one ACTIVE endpoint per (client_id, environment, topic)"
        text secret "dash_whsec_<32 base62>, plaintext signing key, shown once"
        timestamptz disabled_at "nullable — set once, never unset; rows never deleted"
        text created_by
        timestamptz created_at
    }
    WEBHOOK_OUTBOX {
        uuid id PK
        uuid event_id "partner dedupe key — same on every fan-out row and retry"
        uuid endpoint_id FK "soft → webhook_endpoints.id; NULL = SKIPPED NO_ACTIVE_ENDPOINT (client has endpoints, none active)"
        text topic "SHIPMENT|OUTBOUND_ORDER"
        uuid ref_id "shipments.id | wh_outbound_orders.id — retry group key with endpoint_id"
        text ref_label "waybill | order code (denormalized for the webhook list)"
        text ref_external_id "booking_id | external_id (denormalized for the webhook list)"
        uuid shipment_id "nullable — legacy, = ref_id for SHIPMENT; dropped after one retention cycle"
        integer client_id
        text environment "LIVE|TEST"
        text event_type "outbox label: CREATED|ARRIVED_AT_HUB|…|MILESTONE_COMPLETED | ORDER_STATUS_CHANGED"
        integer sequence "per-ref ordering key (shipments.event_seq / wh_outbound_orders.event_seq); gaps legal"
        json payload "frozen envelope {status,message,data:{event, shipment|order}} — json not jsonb (key order)"
        text status "PENDING|PROCESSING|DONE|FAILED|DEAD|SKIPPED"
        integer attempts "reset to 0 by a manual retry"
        timestamptz next_retry_at
        text last_error "HTTP <status>: <body…> | fetch failed … | timeout | NO_ACTIVE_ENDPOINT"
        timestamptz processing_at
        timestamptz delivered_at
        timestamptz created_at
    }
    WEBHOOK_DELIVERY_ATTEMPTS {
        uuid id PK
        uuid outbox_id FK "soft → webhook_outbox.id; pruned with it (DONE 30d, DEAD/SKIPPED 90d)"
        integer attempt_no "unique with outbox_id"
        integer http_status "nullable — null on timeout/DNS/reclaim"
        integer latency_ms
        text error "nullable — same format as webhook_outbox.last_error; RECLAIMED for a stalled worker"
        timestamptz attempted_at
    }
    WEBHOOK_ENDPOINTS ||--o{ WEBHOOK_OUTBOX : "fan-out target (endpoint_id, nullable)"
    WEBHOOK_OUTBOX ||--o{ WEBHOOK_DELIVERY_ATTEMPTS : "one row per POST attempt"
    SHIPMENTS ||--o{ WEBHOOK_OUTBOX : "topic SHIPMENT (ref_id)"
    WH_OUTBOUND_ORDERS ||--o{ WEBHOOK_OUTBOX : "topic OUTBOUND_ORDER (ref_id)"
